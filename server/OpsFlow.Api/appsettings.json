{
  "ConnectionStrings": {
    "OpsFlow": "Server=localhost,1433;Database=OpsFlow;User Id=sa;Password=Your_strong_password123!;TrustServerCertificate=True;Encrypt=False"
  },
  "Jwt": {
    "Issuer": "OpsFlow.Api",
    "Audience": "OpsFlow.Client",
    "Key": "replace-this-development-key-with-at-least-32-characters"
  },
  "AllowedOrigins": ["http://localhost:3000", "http://localhost:3001", "http://localhost:5173"],
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [{ "Name": "Console" }],
    "Enrich": ["FromLogContext"]
  }
}
